{
  "expo": {
    "name": "Igualo",
    "slug": "igualo-walo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/splash-premium.png",
    "scheme": "igualo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.euskodev.igualo",
      "supportsTablet": true
    },
    "android": {
      "package": "com.euskodev.igualo",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/splash-premium.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/igualo-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-black.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-audio",
      "expo-asset",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Igualo necesita acceso a tus fotos para que puedas subir imágenes de tus anuncios y perfil.",
          "cameraPermission": "Igualo necesita acceso a tu cámara para tomar la foto de verificación de identidad."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Igualo necesita acceso a tu cámara para el escáner de verificación de identidad."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0b3d4242-15a5-49f8-a9df-a8059527e048"
      }
    },
    "owner": "euskodev"
  }
}
